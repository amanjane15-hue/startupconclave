{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "server.js": {
      "includeFiles": [
        "index.html",
        "style.css",
        "app.js"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/server.js"
    },
    {
      "source": "/register",
      "destination": "/server.js"
    },
    {
      "source": "/contact",
      "destination": "/server.js"
    },
    {
      "source": "/subscribe",
      "destination": "/server.js"
    },
    {
      "source": "/admin/:path*",
      "destination": "/server.js"
    }
  ]
}
